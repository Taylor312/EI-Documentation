source 'https://rubygems.org'

gem "jekyll", "~> 4.4.1"
gem "just-the-docs", "0.12.0"

# Optional on Windows for `jekyll serve` file watching. Do not use
# `if Gem.win_platform?` — that makes the Linux CI Gemfile disagree with
# a Windows-generated Gemfile.lock and breaks `bundle install`.
gem "wdm", ">= 0.1.0", platforms: :windows
